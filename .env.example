# Copier vers .env.local (ignoré par git) puis remplir.
# Supabase local : `npx supabase start` affiche l'URL et la clé anon.
# Projet hébergé : Project Settings → API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Uniquement côté serveur (Edge Functions), jamais préfixé VITE_ :
# TMDB_API_KEY=

# Notifications push (lot 10) : clé VAPID publique, générée avec `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=
# La clé privée et le secret du cron restent côté serveur (supabase secrets set) :
# VAPID_PRIVATE_KEY=  VAPID_PUBLIC_KEY=  VAPID_SUBJECT=mailto:…  PUSH_CRON_SECRET=
